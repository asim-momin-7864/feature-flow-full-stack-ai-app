# Supabase Public Keys (exposed to browser)
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Supabase Secret Service Role Key (server-only, bypasses RLS)
SUPABASE_SECRET_KEY=your-supabase-secret-key

# Google Gemini API Key (used by @ai-sdk/google)
GOOGLE_GENERATIVE_AI_API_KEY=your-google-ai-api-key

# LLM Model for feedback triage & tagging (optional - defaults to gemini-3.1-flash-lite)
LLM_MODEL=gemini-3.1-flash-lite

